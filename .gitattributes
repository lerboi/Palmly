# Normalize line endings: LF in the repo, auto on checkout. Keeps diffs clean across Windows/macOS.
* text=auto eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mov binary
*.keystore binary
*.jks binary
*.p8 binary
*.p12 binary
