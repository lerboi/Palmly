# Palmly — environment variable template.
# Copy to .env.staging / .env.prod (and app/.env for client keys) and fill real values.
# See docs/ENVIRONMENT.md for what each key is, where it comes from, and which task uses it.
# NEVER commit a filled-in copy. Only this .example file is tracked.

# ── Client bundle (EXPO_PUBLIC_* — safe to ship) ──────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@o000000.ingest.sentry.io/0000000
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_ios_public_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_revenuecat_android_public_key
EXPO_PUBLIC_APPSFLYER_DEV_KEY=your-appsflyer-dev-key
EXPO_PUBLIC_APPSFLYER_APP_ID=1234567890
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000

# ── Server-only (Supabase Vault / Edge Function secrets) ──────────────
GEMINI_API_KEY=your-gemini-paid-tier-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000
REVENUECAT_WEBHOOK_AUTH=your-shared-webhook-authorization-secret
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_v2_key
APPSFLYER_S2S_API_TOKEN=your-appsflyer-s2s-api-token

# ── CI / build (GitHub Actions + EAS secrets) ─────────────────────────
EXPO_TOKEN=your-expo-access-token
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_cli_access_token
SUPABASE_STAGING_PROJECT_REF=your-staging-project-ref
SUPABASE_PROD_PROJECT_REF=your-prod-project-ref
SUPABASE_STAGING_DB_PASSWORD=your-staging-db-password
SUPABASE_PROD_DB_PASSWORD=your-prod-db-password
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=palmly

# ── Store submission (EAS Submit) ─────────────────────────────────────
APPLE_TEAM_ID=XXXXXXXXXX
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# App Store Connect .p8 and Google Play service-account JSON are files, not env vars —
# store them out-of-repo and reference by path in eas.json (see docs/ENVIRONMENT.md §5).
