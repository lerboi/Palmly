{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["palmly"],
  "ios": {
    "iosModuleName": "PalmLandmarks"
  },
  "android": {
    "androidNamespace": ["palmly"],
    "androidCxxLibName": "PalmLandmarks"
  },
  "autolinking": {
    "HandLandmarkerFactory": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridHandLandmarkerFactory"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
